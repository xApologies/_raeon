{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAEON Hypervisor v2 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "message_id",
    "application_id",
    "epoch",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "enum": [
        "HELLO",
        "INTENT",
        "SYNC_REQUEST",
        "ACK",
        "HEARTBEAT",
        "WELCOME",
        "SNAPSHOT",
        "DELTA",
        "RECEIPT",
        "EVENT",
        "ERROR",
        "HEARTBEAT_ACK"
      ]
    },
    "payload": {
      "type": "object"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "delivery_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "description": "Full direction-specific body checks are implemented in validation.py; integers exact within 53 bits; depth <=24."
}

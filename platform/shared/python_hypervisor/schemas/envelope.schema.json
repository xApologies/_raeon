{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAEON Hypervisor v2 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "message_id",
    "application_id",
    "epoch",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "enum": [
        "HELLO",
        "INTENT",
        "SYNC_REQUEST",
        "ACK",
        "HEARTBEAT",
        "WELCOME",
        "SNAPSHOT",
        "DELTA",
        "RECEIPT",
        "EVENT",
        "ERROR",
        "HEARTBEAT_ACK"
      ]
    },
    "payload": {
      "type": "object"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "delivery_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "description": "Direction, matching envelope/body epoch and commit identity, duplicate-key, depth and finite numeric rules are additionally enforced by validation.py and codec.py.",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "HELLO"
        },
        "payload": {
          "type": "object",
          "required": [
            "protocol"
          ],
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": 2
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "INTENT"
        },
        "payload": {
          "type": "object",
          "required": [
            "request_id",
            "operation",
            "arguments",
            "expected_revision"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "operation": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "arguments": {
              "type": "object"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "SYNC_REQUEST"
        },
        "payload": {
          "type": "object",
          "required": [
            "view_id",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "view_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "ACK"
        },
        "payload": {
          "type": "object",
          "required": [
            "delivery_sequence"
          ],
          "additionalProperties": false,
          "properties": {
            "delivery_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "HEARTBEAT"
        },
        "payload": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "WELCOME"
        },
        "payload": {
          "type": "object",
          "required": [
            "protocol",
            "view_id"
          ],
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": 2
            },
            "view_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "HEARTBEAT_ACK"
        },
        "payload": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "SNAPSHOT"
        },
        "payload": {
          "type": "object",
          "required": [
            "view_id",
            "epoch",
            "revision",
            "digest",
            "view"
          ],
          "additionalProperties": false,
          "properties": {
            "view_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "view": {
              "type": "object"
            },
            "state_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "DELTA"
        },
        "payload": {
          "type": "object",
          "required": [
            "view_id",
            "epoch",
            "base_revision",
            "revision",
            "commit_id",
            "changes",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "view_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "epoch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "base_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "commit_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "changes": {
              "type": "object"
            },
            "digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "state_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "RECEIPT"
        },
        "payload": {
          "type": "object",
          "required": [
            "status",
            "request_id"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "REJECTED",
                "COMMITTED",
                "OBSERVED",
                "FAULTED_OR_UNKNOWN"
              ]
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "previous_root": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "root": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "commit_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "native_execution": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "inward": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "outward": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "code": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "ERROR"
        },
        "payload": {
          "type": "object",
          "required": [
            "code"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "EVENT"
        },
        "payload": {
          "type": "object",
          "required": [
            "name",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

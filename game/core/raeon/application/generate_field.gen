genesis 0.1.0
module generate_field {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"extension","abi":"raeon-color-prime-values-v1","operation":"GENERATE_FIELD","effect_source":"conformance:pass04:generate_field","requires":["ordinary_live_source","current_magnitude","READY_once","owned_prime","authority_window","health_before_charge","no_overflow","fresh_revisions","road_close"]}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

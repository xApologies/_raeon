  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"extension","abi":"raeon-color-prime-values-v1","operation":"WHITE_RESTORE_PRIME","effect_source":"conformance:pass04:white_restore_prime","requires":["admitted_white_restore","friendly_INACTIVE","same_identity_slot","H_1_C_0","fresh_revisions","road_close"]}}

genesis 0.1.0
module retire_support {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"transfer","selection":{"mode":"selected","items":"$arg.cards","source_kinds":["CONFIGURATION_SPACE"]},"destination":"{owner}_graveyard","destination_kinds":["GRAVEYARD"],"categories":["Field Generator"],"minimum":1,"maximum":60,"placement":"top","effect_source":"conformance:whole-support-retirement","whole_collection":true}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

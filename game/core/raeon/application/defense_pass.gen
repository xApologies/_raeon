genesis 0.1.0
module defense_pass {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"extension","abi":"raeon-match-tempo-v1","operation":"DEFENSE_PASS","effect_source":"conformance:pass05:defense_pass","requires":["OPEN_WINDOW","DEFENDER","PASS_OR_TRUSTED_TIMEOUT","NO_TIMER_SECONDS"],"rules":{"opening_draw":7,"hand_maximum":10,"normal_draw":1,"constructed_deck":60,"mulligan_enabled":true,"mulligan_procedure":"OPEN","hand_overflow":"OPEN_ATOMIC_REJECTION","first_player":"TRUSTED_FAIR_BINARY_OUTCOME","first_player_prng":"OPEN","compensation":{"count":1,"ordinary_deck_card":false,"occupies_hand":true,"draw":1,"single_use":true,"resource_cost":0,"identity_name_flavor":"OPEN","timing":"OPEN"},"phases":["REFRESH","DRAW","ACTIVE","END"],"refresh":"OWN_TURN_BEGINNING_ONLY","end_or_switch_refresh":false,"refresh_heals":false,"refresh_changes_topology":false,"charge":{"storage":["H","N","R"],"quantity":"Q=N*rank+R","health_maximum":"native_rank","node_cap":null,"restore_order":["H","Q"],"degrade_order":["Q","H"],"migration":"N=C//rank; R=C%rank","self_restore":false,"white_reactivation":[1,0,0]},"defense":{"order":["DEGRADE","CONSEQUENCES","TERMINAL_CHECK","LEGAL_OPTIONS","ONE_RESTORE_OR_PASS"],"target":"JUST_DEGRADED_SURVIVING_OBJECT","seconds":"OPEN","timeout":"EXPLICIT_PASS_EVENT","field_assisted_response":"ONE_ATOMIC_RESPONSE","degrade_source_allowed":false},"utility":{"generic_resource_cost":0,"requires":["HAND_SOURCE","ADMITTED_TIMING","TARGET","MATHEMATICS","EFFECT"],"generic_timing":"OPEN","generic_disposition":"UNSUPPLIED"},"loss":"ALL_THREE_OWNED_BOUND_PRIMES_INACTIVE","terminal_before_defense":true,"post_terminal_gameplay":false,"simultaneous_terminal":"OPEN","exhaustion":[{"stage":1,"color":"RED","magnitude":1},{"stage":2,"color":"ORANGE","magnitude":2},{"stage":3,"color":"YELLOW","magnitude":3},{"stage":4,"color":"GREEN","magnitude":4},{"stage":5,"color":"BLUE","magnitude":5},{"stage":6,"color":"VIOLET","magnitude":6}],"exhaustion_target":"OPEN","exhaustion_stage_7_plus":"OPEN","exhaustion_applies_damage":false}}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

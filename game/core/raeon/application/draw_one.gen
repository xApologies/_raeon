genesis 0.1.0
module draw_one {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"transfer","selection":{"mode":"top","source":"{owner}_deck","source_kinds":["DECK"],"count":1},"categories":["Field Generator","Prime","Utility"],"destination":"{owner}_hand","destination_kinds":["HAND"],"exact":1,"maximum":1,"placement":"bottom","effect_source":"conformance:bounded-draw"}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

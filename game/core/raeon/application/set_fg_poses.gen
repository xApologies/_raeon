genesis 0.1.0
module set_fg_poses {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"extension","abi":"raeon-topology-values-v1","operation":"set_poses","effect_source":"conformance:topology:set_poses","pose_schema":"xy-quaternion-integer-v1","maximum":16,"requires":["owner","membership","pose_revision","proper_rotation","road_close"]}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

genesis 0.1.0
module spend_prime {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"extension","abi":"raeon-color-prime-values-v1","operation":"SPEND_PRIME","effect_source":"conformance:pass04:spend_prime","requires":["healthy_charged_source","partial_charge_only","family_direction","authority_window","target_side","charge_before_health","native_maximum","zero_support_retirement","fresh_revisions","road_close"]}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

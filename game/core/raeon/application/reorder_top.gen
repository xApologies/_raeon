genesis 0.1.0
module reorder_top {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"reorder","selection":{"mode":"selected","items":"$arg.cards","source":"{owner}_deck","source_kinds":["DECK"]},"categories":["Field Generator","Prime","Utility"],"minimum":1,"maximum":7,"effect_source":"conformance:bounded-top-reorder"}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

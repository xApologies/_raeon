genesis 0.1.0
module batch_to_hand {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"transfer","selection":{"mode":"selected","items":"$arg.cards","source_kinds":["DECK"]},"destination":"{owner}_hand","destination_kinds":["HAND"],"categories":["Field Generator","Prime","Utility"],"minimum":1,"maximum":3,"placement":"bottom","effect_source":"conformance:bounded-batch-transfer"}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}

genesis 0.1.0
module initialize_inventory {
  en fabric : FABRIC = mount "fabric://horizon/locked-v1"
  en region : REGION = alloc fabric cells 32
  en match : GEOMETRIC = instantiate fabric region mmo @bound_match
  admit match as permission @{"operation":"COLLECTION_TRANSACTION","abi":"state-collections-v1","action":{"kind":"materialize","records":"$arg.roster","count":60,"categories":["Field Generator","Prime","Utility"],"destination":"{owner}_deck","destination_kinds":["DECK"],"effect_source":"conformance:neutral-inventory-setup"}}
  transform match with permission as candidate @{"operator":"COLLECTION_TRANSACTION"}
  assert closure candidate as closed
  export candidate : GEOMETRIC
}
